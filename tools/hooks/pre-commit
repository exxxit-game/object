#!/bin/sh
# No commit with a broken test: npm test runs before every commit (tools/hooks, set once per
# clone with git config core.hooksPath tools/hooks). The tests are pure node, a few seconds.
# git sets GIT_DIR and GIT_INDEX_FILE for a hook: unset, no test's git can reach into this repository
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_PREFIX GIT_EDITOR
npm test --silent > /dev/null 2>&1 || { echo "STOP  npm test fails: run it to see why; nothing was committed"; exit 1; }
exit 0
